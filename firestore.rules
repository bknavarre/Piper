rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /communityGroceryObservations/{observationId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['itemName','store','zip','category','aisle','price','observedAt','schemaVersion'])
        && request.resource.data.itemName is string && request.resource.data.itemName.size() >= 1 && request.resource.data.itemName.size() <= 120
        && request.resource.data.store is string && request.resource.data.store.size() >= 1 && request.resource.data.store.size() <= 80
        && request.resource.data.zip is string && request.resource.data.zip.size() <= 5
        && request.resource.data.category is string && request.resource.data.category.size() <= 80
        && request.resource.data.aisle is string && request.resource.data.aisle.size() <= 80
        && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 9999
        && request.resource.data.observedAt is number
        && request.resource.data.schemaVersion == 1;
      allow read, update, delete: if false;
    }
  }
}
