rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── Helpers ─────────
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() && request.auth.token.email in ['bknavarre@gmail.com'];
    }

    function entOk(uid, plans) {
      let p = /databases/$(database)/documents/entitlements/$(uid);
      return exists(p) && get(p).data.active == true && get(p).data.plan in plans &&
             (get(p).data.get('expiresAt', null) == null || get(p).data.expiresAt > request.time);
    }

    function familyActive(hid) { return entOk(hid, ['family']); }

    function hasPro(uid) {
      let m = /databases/$(database)/documents/memberships/$(uid);
      return entOk(uid, ['pro', 'family']) || (exists(m) && familyActive(get(m).data.householdId));
    }

    // Pass 18: family sharing
    function inHousehold(hid, uid) {
      let h = /databases/$(database)/documents/households/$(hid);
      return exists(h) && uid in get(h).data.members;
    }
    function myHousehold() {
      let m = /databases/$(database)/documents/memberships/$(request.auth.uid);
      return exists(m) ? get(m).data.householdId : request.auth.uid;
    }
    function sameFamily(owner) {
      let hid = myHousehold();
      return familyActive(hid) && inHousehold(hid, request.auth.uid) && inHousehold(hid, owner);
    }

    // ───────── Your Piper data (recipes, kitchen state, etc.) ─────────
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    // Everything under the user EXCEPT the AI usage counter (stricter rule below)
    match /users/{userId}/{collection}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == userId && collection != 'usage';
    }
    // Pass 18: family members can READ each other's shared (non-private) recipes. Never write.
    match /users/{userId}/recipes/{recipeId} {
      allow read: if signedIn() && request.auth.uid != userId &&
        resource.data.familyPrivate == false && sameFamily(userId);
    }

    // ───────── Monthly AI counter: +1 at a time, never past the plan limit ─────────
    match /users/{uid}/usage/{month} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.aiActions == 1;
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.aiActions == resource.data.aiActions + 1 &&
        request.resource.data.aiActions <= (hasPro(uid) ? 100 : 5);
      allow delete: if isAdmin();
    }

    // ───────── Who has Pro / Family. Only admins (later: purchase webhook) write. ─────────
    match /entitlements/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() ||
        (exists(/databases/$(database)/documents/households/$(uid)) &&
         request.auth.uid in get(/databases/$(database)/documents/households/$(uid)).data.members));
      allow write: if isAdmin();
    }

    // ───────── Member directory ─────────
    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['email', 'displayName', 'lastSeen', 'plan', 'planSource',
          'householdId', 'familyRole', 'recipesActive', 'recipesArchived', 'aiUsedThisMonth']);
      allow delete: if isAdmin();
    }

    // ───────── Family households (doc id = owner uid) ─────────
    function joining(hid) {
      let d = request.resource.data;
      return !(request.auth.uid in resource.data.members)
        && d.diff(resource.data).affectedKeys().hasOnly(['members', 'memberCount', 'memberInfo', 'lastJoinCode'])
        && d.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet())
        && d.members.size() <= 5 && d.memberCount == d.members.size()
        && d.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([request.auth.uid])
        && familyActive(hid)
        && exists(/databases/$(database)/documents/invites/$(d.lastJoinCode))
        && get(/databases/$(database)/documents/invites/$(d.lastJoinCode)).data.ownerUid == hid;
    }

    function leaving(hid) {
      let d = request.resource.data;
      return request.auth.uid in resource.data.members && request.auth.uid != hid
        && d.diff(resource.data).affectedKeys().hasOnly(['members', 'memberCount', 'memberInfo'])
        && d.memberCount == d.members.size()
        && d.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet());
    }

    match /households/{hid} {
      allow get: if signedIn() && (isAdmin() || request.auth.uid in resource.data.members);
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == hid && familyActive(hid) &&
        request.resource.data.ownerUid == hid && request.resource.data.members == [hid] &&
        request.resource.data.memberCount == 1;
      allow update: if signedIn() && (
        (request.auth.uid == hid && request.resource.data.ownerUid == hid &&
         hid in request.resource.data.members && request.resource.data.members.size() <= 5 &&
         request.resource.data.get('memberCount', 0) == request.resource.data.members.size())
        || joining(hid) || leaving(hid) || isAdmin());
      allow delete: if signedIn() && (request.auth.uid == hid || isAdmin());

      // Shared family data (Pass 18: the shared grocery list lives at shared/grocery)
      match /shared/{rest=**} {
        allow read, write: if signedIn() && familyActive(hid) &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
      }
    }

    // ───────── Invite codes ─────────
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid &&
        familyActive(request.auth.uid);
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // ───────── Which family a user belongs to ─────────
    match /memberships/{uid} {
      allow read: if signedIn() &&
        (request.auth.uid == uid || resource.data.householdId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.householdId != uid &&
        request.auth.uid in getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members;
      allow update: if isAdmin();
      allow delete: if signedIn() &&
        (request.auth.uid == uid || resource.data.householdId == request.auth.uid || isAdmin());
    }

// ───────── Pass 20: beta feedback ─────────
// Paste this block inside "match /databases/{database}/documents { ... }",
// for example just above the "Community grocery prices" section.
    match /betaFeedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','email','category','area','message','diagnostics','status','createdAt','schemaVersion'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ['bug','idea','look','love','other']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1 && request.resource.data.message.size() <= 4000
        && request.resource.data.area is string && request.resource.data.area.size() <= 40
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && (request.resource.data.diagnostics == null || request.resource.data.diagnostics is map)
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is number
        && request.resource.data.schemaVersion == 1;
      // Testers can never read anyone's reports. Only you (isAdmin) can read or update them.
      allow read, update, delete: if isAdmin();
    }


    // ───────── Community grocery prices (unchanged) ─────────
    match /communityGroceryObservations/{observationId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['itemName','store','zip','category','aisle','price','observedAt','schemaVersion'])
        && request.resource.data.itemName is string && request.resource.data.itemName.size() >= 1 && request.resource.data.itemName.size() <= 120
        && request.resource.data.store is string && request.resource.data.store.size() >= 1 && request.resource.data.store.size() <= 80
        && request.resource.data.zip is string && request.resource.data.zip.size() <= 5
        && request.resource.data.category is string && request.resource.data.category.size() <= 80
        && request.resource.data.aisle is string && request.resource.data.aisle.size() <= 80
        && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.price <= 9999
        && request.resource.data.observedAt is number
        && request.resource.data.schemaVersion == 1;
      allow read, update, delete: if false;
    }
  }
}
